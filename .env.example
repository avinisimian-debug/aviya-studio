# Public site URL used for canonical links, sitemap, and Open Graph.
# Set this after the real domain is connected.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console HTML-tag verification. Leave empty to omit the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# GA4 measurement ID. The tag loads only after the visitor accepts.
# Leave empty to keep analytics off.
NEXT_PUBLIC_GA_ID=

# Shown as phone / WhatsApp buttons. Hidden completely when empty.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Optional override. Defaults to studio.aviya1@gmail.com.
NEXT_PUBLIC_STUDIO_EMAIL=

# Lead email. Both must be set or the form returns NOT CONFIGURED
# and does not pretend the inquiry was sent.
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Optional. Defaults to Aviya Studio <onboarding@resend.dev>
RESEND_FROM=
