# Public site URL used for canonical links, sitemap, and Open Graph.
# Set this after the real domain is connected.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Search Console HTML-tag verification. Leave empty to omit the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# GA4 measurement ID. The tag loads only after the visitor accepts.
# Leave empty to keep analytics off.
NEXT_PUBLIC_GA_ID=

# Optional overrides. Defaults: 055-557-3090 and wa.me/972555573090.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Public address shown on the site. Defaults to studio.aviya1@gmail.com.
NEXT_PUBLIC_STUDIO_EMAIL=

# Lead delivery. Without RESEND_API_KEY the form opens WhatsApp and a mailto
# to the leads inbox. It does not pretend the server sent the inquiry.
# LEADS_TO_EMAIL defaults to aviya.nish@gmail.com.
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Optional. Defaults to Aviya Studio <onboarding@resend.dev>
RESEND_FROM=
