# Public URL of THIS live deployment (no trailing slash).
# Must match the URL people actually open — otherwise Google indexes the wrong host.
#
# While on Vercel without a custom domain, use the production alias:
NEXT_PUBLIC_SITE_URL=https://studio-seven-beta-89.vercel.app
#
# After you connect a real domain in Vercel (e.g. aviya.co.il), change to:
# NEXT_PUBLIC_SITE_URL=https://aviya.co.il

# Google Search Console → Settings → Ownership verification → HTML tag
# Paste ONLY the content= value (long string), not the whole meta tag
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Security / leads admin ───
# Required in production (min 8 chars). Open inbox at: https://YOUR-SITE/leads
# LEADS_PASSWORD=choose-a-long-random-password

# Where to email every new lead (default: aviya.nish@gmail.com)
LEADS_NOTIFY_EMAIL=aviya.nish@gmail.com

# Optional: Resend (more reliable email)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Aviya <onboarding@resend.dev>

# WhatsApp alerts (free CallMeBot — one-time setup):
# 1) https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 2) Set the API key and number, redeploy:
# CALLMEBOT_APIKEY=123456
# LEADS_NOTIFY_WHATSAPP=972555573090

# Optional: Zapier / Make / n8n webhook
# LEADS_WEBHOOK_URL=https://hooks.example.com/aviya-leads
